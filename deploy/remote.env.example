# deploy/remote.env.example — copy to deploy/remote.env (gitignored) and fill in.
# Where deploy/remote.sh deploys to. No secrets belong here: the server keeps its own env file.

# an ssh host (as in ~/.ssh/config), or "local" to deploy on this machine
DEPLOY_HOST=my-server
# directory on the server that holds docker-compose.yml (relative to the home directory, or absolute)
DEPLOY_DIR=infra/tossinvest-mcp
# compose service to replace, and the image repository it runs
DEPLOY_SERVICE=tossinvest-mcp
DEPLOY_IMAGE=tossinvest-mcp
# OPTIONAL command run on the server after the swap. If it fails, the deploy rolls back.
# DEPLOY_POST_CHECK="docker exec my-mcp-client my-client mcp test tossinvest"
